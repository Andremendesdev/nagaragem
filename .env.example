# ============================================================
# Supabase — Dashboard → Settings → API Keys
# ============================================================

# URL do projeto (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# RECOMENDADO: Legacy anon key (aba "Legacy API Keys", começa com eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alternativa: publishable key (aba "API Keys", sb_publishable_...)
# Só use se estiver ativa no projeto — se der "Invalid API key", use a anon acima.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ============================================================
# Admin único
# ============================================================

# Mesmo e-mail do usuário criado em Authentication → Users
ADMIN_EMAIL=

# Opcional — só para: pnpm create-admin
# ADMIN_PASSWORD=
# SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Google Analytics 4 (opcional — padrão: G-L48FSV5JG3)
# ============================================================

# Measurement ID (client-side, tag no site)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Painel /admin/visitas — Google Analytics Data API (somente servidor)
# 1. GA4 → Admin → Detalhes da propriedade → ID da propriedade (numérico)
# 2. Google Cloud → ativar "Google Analytics Data API" → criar Service Account → baixar JSON
# 3. GA4 → Admin → Acesso à propriedade → adicionar e-mail da service account como Leitor
# GA4_PROPERTY_ID=512345678
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
